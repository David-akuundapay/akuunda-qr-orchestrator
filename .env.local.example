# Exemple de fichier .env.local pour les tests
# Copiez ce fichier vers .env.local et remplissez avec vos vraies valeurs

# ============================================
# KEYCLOAK AUTHENTICATION (REQUIS)
# ============================================
# URL du serveur d'authentification Keycloak
KEYCLOAK_TOKEN_URL=https://auth.akuunda-pay.io/realms/akuunda/protocol/openid-connect/token

# Credentials Keycloak (demandez à votre admin)
KEYCLOAK_USERNAME=votre_username_ici
KEYCLOAK_PASSWORD=votre_password_ici
KEYCLOAK_CLIENT_ID=votre_client_id_ici
KEYCLOAK_CLIENT_SECRET=votre_client_secret_ici

# ============================================
# AKUUNDA API
# ============================================
# URL de base de l'API interne Akuunda
AKUUNDA_API_BASE_URL=https://walletdev.akuunda-pay.io

# ============================================
# YELLOWCARD (OPTIONNEL)
# ============================================
# Channel ID YellowCard (sera récupéré dynamiquement si non fourni)
YELLOWCARD_CHANNEL_ID=

# ============================================
# FRONTEND
# ============================================
# Base path de l'API frontend
NEXT_PUBLIC_API_BASE=/api

# ============================================
# NOTES
# ============================================
# 1. Ne commitez JAMAIS ce fichier avec de vraies valeurs
# 2. Les variables KEYCLOAK_* sont OBLIGATOIRES
# 3. AKUUNDA_API_BASE_URL pointe vers l'environnement de développement
# 4. Pour tester en local, créez .env.local (ignoré par git)
